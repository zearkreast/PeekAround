// Icons of the photo editor and the collage (lucide).

export global EIcons {
    out property <image> undo: @image-url("icons/undo-2.svg");
    out property <image> redo: @image-url("icons/redo-2.svg");
    out property <image> crop: @image-url("icons/crop.svg");
    out property <image> flip-h: @image-url("icons/flip-horizontal-2.svg");
    out property <image> flip-v: @image-url("icons/flip-vertical-2.svg");
    out property <image> rotate-left: @image-url("icons/rotate-ccw-square.svg");
    out property <image> rotate-right: @image-url("icons/rotate-cw-square.svg");
    out property <image> zoom-100: @image-url("icons/scan-search.svg");
    out property <image> fit: @image-url("icons/maximize.svg");
    out property <image> reset: @image-url("icons/rotate-ccw.svg");
    out property <image> image-off: @image-url("icons/image-off.svg");
    out property <image> brush: @image-url("icons/brush.svg");
    out property <image> eraser: @image-url("icons/eraser.svg");
    out property <image> bold: @image-url("icons/bold.svg");
    out property <image> italic: @image-url("icons/italic.svg");
    out property <image> align-left: @image-url("icons/text-align-start.svg");
    out property <image> align-center: @image-url("icons/text-align-center.svg");
    out property <image> align-right: @image-url("icons/text-align-end.svg");
    out property <image> type: @image-url("../pages/icons/type.svg");
    out property <image> copy: @image-url("../pages/icons/copy.svg");
}
