// Pieces shared by the photo and the video editor: icons, slider row, swatches, switches, tool
// tabs and the text layer property panel (components/TextLayerControls).

import { Theme, Motion, I18n } from "../theme.slint";
import { Icons } from "../icons.slint";

export global EIcons {
    out property <image> undo: @image-url("icons/undo-2.svg");
    out property <image> redo: @image-url("icons/redo-2.svg");
    out property <image> crop: @image-url("icons/crop.svg");
    out property <image> flip-h: @image-url("icons/flip-horizontal-2.svg");
    out property <image> flip-v: @image-url("icons/flip-vertical-2.svg");
    out property <image> rotate-left: @image-url("icons/rotate-ccw-square.svg");
    out property <image> rotate-right: @image-url("icons/rotate-cw-square.svg");
    out property <image> zoom-100: @image-url("icons/scan-search.svg");
    out property <image> fit: @image-url("icons/maximize.svg");
    out property <image> reset: @image-url("icons/rotate-ccw.svg");
    out property <image> image-off: @image-url("icons/image-off.svg");
    out property <image> brush: @image-url("icons/brush.svg");
    out property <image> eraser: @image-url("icons/eraser.svg");
    out property <image> bold: @image-url("icons/bold.svg");
    out property <image> italic: @image-url("icons/italic.svg");
    out property <image> align-left: @image-url("icons/text-align-start.svg");
    out property <image> align-center: @image-url("icons/text-align-center.svg");
    out property <image> align-right: @image-url("icons/text-align-end.svg");
    out property <image> type: @image-url("../pages/icons/type.svg");
    out property <image> copy: @image-url("../pages/icons/copy.svg");
}


export struct EdFont {
    family: string,
    label: string,
}

// the selected text layer's properties (opacity in %, sizes in frame px)
export struct EdText {
    id: int,
    text: string,
    family: string,
    weight: float,
    wmin: float,
    wmax: float,
    italic: bool,
    italic-ok: bool,
    bold: bool,
    size: float,
    size-max: float,
    color: color,
    align: string,
    spacing: float,
    line: float,
    rotation: float,
    opacity: float,
    stroke: bool,
    stroke-color: color,
    stroke-width: float,
    stroke-max: float,
    shadow: bool,
    shadow-color: color,
    shadow-blur: float,
    shadow-x: float,
    shadow-y: float,
    bg: bool,
    bg-color: color,
    bg-padding: float,
    bg-radius: float,
    bg-max: float,
}


// slider filled from `origin` (1.x Slider `center`); double-click resets
export component EdSliderRow inherits VerticalLayout {
    in property <string> label;
    in property <string> value-text;
    in property <float> value;
    in property <float> minimum: -100;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in property <float> origin: 0;
    in property <bool> has-hint;
    in property <brush> hint;
    callback changed(float);
    callback reset();
    spacing: 2px;
    HorizontalLayout {
        spacing: 8px;
        if root.has-hint: VerticalLayout {
            alignment: center;
            Rectangle { width: 10px; height: 10px; border-radius: 5px; background: root.hint; border-width: 1px; border-color: #ffffff26; }
        }
        Text { text: root.label; font-size: 13px; color: root.value != root.origin ? Theme.text : Theme.text-dim; vertical-alignment: center; }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: Theme.accent;
                opacity: root.value != root.origin ? 1 : 0;
                animate opacity { duration: Motion.fast; }
            }
        }
        Rectangle { horizontal-stretch: 1; }
        Text { text: root.value-text; font-size: 12px; color: Theme.text-faint; vertical-alignment: center; }
    }
    Rectangle {
        height: 22px;
        property <float> span: Math.max(0.0001, root.maximum - root.minimum);
        property <float> f: Math.clamp((root.value - root.minimum) / self.span, 0, 1);
        property <float> f0: Math.clamp((root.origin - root.minimum) / self.span, 0, 1);
        property <length> track: self.width - 16px;
        Rectangle {
            y: (parent.height - self.height) / 2;
            height: 4px;
            border-radius: 2px;
            background: Theme.surface-3;
        }
        Rectangle {
            x: 8px + parent.track * Math.min(parent.f, parent.f0);
            y: (parent.height - self.height) / 2;
            width: parent.track * Math.abs(parent.f - parent.f0);
            height: 4px;
            border-radius: 2px;
            background: Theme.accent;
        }
        Rectangle {
            property <length> s: ta.pressed ? 18px : 14px;
            animate s { duration: Motion.fast; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
            width: self.s;
            height: self.s;
            x: 8px + parent.track * parent.f - self.s / 2;
            y: (parent.height - self.height) / 2;
            border-radius: self.s / 2;
            background: #ffffff;
            drop-shadow-blur: 6px;
            drop-shadow-color: #00000059;
            drop-shadow-offset-y: 1px;
        }
        ta := TouchArea {
            mouse-cursor: pointer;
            function set-from(px: length) {
                let f = Math.clamp((px - 8px) / Math.max(1px, self.width - 16px), 0, 1);
                let raw = root.minimum + f * (root.maximum - root.minimum);
                let v = Math.clamp(Math.round(raw / root.step) * root.step, root.minimum, root.maximum);
                if v != root.value {
                    root.changed(v);
                }
            }
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                    self.set-from(self.mouse-x);
                }
            }
            moved => { self.set-from(self.mouse-x); }
            double-clicked => { root.reset(); }
        }
    }
}

export component Heading inherits Text {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.8px;
    color: Theme.text-faint;
}

export component ToolTab inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    height: 54px;
    horizontal-stretch: 1;
    border-radius: 12px;
    background: root.selected ? Theme.surface-3 : ta.has-hover ? Theme.surface-2 : transparent;
    border-width: root.selected ? 1px : 0px;
    border-color: Theme.accent.with-alpha(0.55);
    animate background { duration: Motion.fast; }
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        HorizontalLayout {
            alignment: center;
            Image { source: root.icon; width: 18px; height: 18px; colorize: root.selected ? Theme.text : Theme.text-dim; }
        }
        Text {
            text: root.text;
            font-size: 11px;
            font-weight: root.selected ? 600 : 500;
            color: root.selected ? Theme.text : Theme.text-dim;
            horizontal-alignment: center;
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component SquareBtn inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    callback clicked();
    height: 48px;
    horizontal-stretch: 1;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border;
    background: ta.pressed ? Theme.surface-3 : ta.has-hover ? Theme.surface-2 : Theme.surface;
    Image { source: root.icon; width: 20px; height: 20px; colorize: ta.has-hover ? Theme.text : Theme.text-dim; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}


// colour swatches that wrap (DrawPanel COLORS); the alpha of `value` is ignored
export component Swatches inherits Rectangle {
    in property <[color]> colors: [#ffffff, #111111, #f43f5e, #f97316, #facc15, #22c55e, #06b6d4, #3b82f6, #8b5cf6, #ec4899];
    in property <color> value;
    callback picked(color);
    property <length> cell: 24px;
    property <length> gap: 3px;
    property <int> cols: Math.max(1, Math.floor((self.width + self.gap) / (self.cell + self.gap)));
    height: Math.ceil(self.colors.length / self.cols) * (self.cell + self.gap) - self.gap;
    for c[i] in root.colors: Rectangle {
        property <bool> on: c.with-alpha(1) == root.value.with-alpha(1);
        x: Math.mod(i, root.cols) * (root.cell + root.gap);
        y: Math.floor(i / root.cols) * (root.cell + root.gap);
        width: root.cell;
        height: root.cell;
        border-radius: root.cell / 2;
        background: self.on ? Theme.accent : transparent;
        Rectangle {
            property <length> s: parent.on ? root.cell - 6px : sw.has-hover ? root.cell + 2px : root.cell;
            animate s { duration: Motion.fast; }
            width: self.s;
            height: self.s;
            border-radius: self.s / 2;
            background: c;
            border-width: 1px;
            border-color: #ffffff26;
        }
        sw := TouchArea { mouse-cursor: pointer; clicked => { root.picked(c); } }
    }
}

// a switch that only reports clicks; the state comes from Rust
export component Toggle inherits Rectangle {
    in property <bool> on;
    callback toggled(bool);
    width: 40px;
    height: 22px;
    border-radius: 11px;
    background: root.on ? Theme.accent : Theme.surface-3;
    animate background { duration: Motion.normal; }
    Rectangle {
        x: root.on ? 20px : 2px;
        y: 2px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: #ffffff;
        animate x { duration: Motion.normal; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.toggled(!root.on); } }
}

export component ToggleHeader inherits HorizontalLayout {
    in property <string> title;
    in property <bool> on;
    callback toggled(bool);
    Text { text: root.title; font-size: 13px; font-weight: 500; color: Theme.text-dim; horizontal-stretch: 1; vertical-alignment: center; }
    Toggle { on: root.on; toggled(v) => { root.toggled(v); } }
}

export component ToolChip inherits Rectangle {
    in property <image> icon;
    in property <bool> on;
    in property <bool> enabled: true;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 9px;
    border-width: 1px;
    border-color: Theme.border;
    opacity: root.enabled ? 1 : 0.4;
    background: root.on ? Theme.surface-3 : ta.has-hover ? Theme.surface-2 : transparent;
    Image { source: root.icon; width: 16px; height: 16px; colorize: root.on ? Theme.text : Theme.text-faint; }
    ta := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// the selected layer: text, font, style, sizes, outline, shadow, background (TextLayerControls)
export component TextProps inherits Rectangle {
    in property <EdText> t;
    // bumps when the text box must show `t.text` again (selection change, undo)
    in property <int> sync;
    // bumps to focus the text box and select its text
    in property <int> focus-seq;
    in property <[EdFont]> fonts;
    callback set-num(string, float);
    callback set-str(string, string);
    callback set-color(string, color);
    callback set-toggle(string, bool);
    property <bool> fonts-open;
    changed sync => { input.text = root.t.text; }
    changed focus-seq => {
        input.text = root.t.text;
        input.focus();
        input.select-all();
    }
    init => { input.text = root.t.text; }
    height: lay.preferred-height;
    border-radius: 22px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    lay := VerticalLayout {
        padding: 14px;
        spacing: 12px;
        Rectangle {
            height: Math.max(76px, input.preferred-height + 20px);
            border-radius: 12px;
            border-width: 1px;
            border-color: input.has-focus ? Theme.accent.with-alpha(0.6) : Theme.border;
            background: Theme.bg-elev;
            TouchArea { mouse-cursor: MouseCursor.text; clicked => { input.focus(); } }
            input := TextInput {
                x: 12px;
                y: 10px;
                width: parent.width - 24px;
                height: parent.height - 20px;
                single-line: false;
                wrap: word-wrap;
                font-size: 14px;
                color: Theme.text;
                selection-background-color: Theme.accent.with-alpha(0.45);
                edited => { root.set-str("text", self.text); }
            }
        }
        // font picker
        VerticalLayout {
            spacing: 6px;
            Rectangle {
                height: 40px;
                border-radius: 12px;
                border-width: 1px;
                border-color: root.fonts-open ? Theme.accent.with-alpha(0.6) : Theme.border;
                background: fta.has-hover ? Theme.surface-2 : Theme.bg-elev;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 10px;
                    spacing: 8px;
                    Text { text: root.t.family; font-family: root.t.family; font-size: 15px; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    Image { source: root.fonts-open ? Icons.chevron-up : Icons.chevron-down; width: 16px; height: 16px; colorize: Theme.text-faint; y: (parent.height - self.height) / 2; }
                }
                fta := TouchArea { mouse-cursor: pointer; clicked => { root.fonts-open = !root.fonts-open; } }
            }
            if root.fonts-open: Rectangle {
                height: Math.min(260px, root.fonts.length * 36px + 8px);
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.bg-elev;
                clip: true;
                Flickable {
                    content-height: root.fonts.length * 36px + 8px;
                    for f[i] in root.fonts: Rectangle {
                        x: 4px;
                        y: 4px + i * 36px;
                        width: parent.width - 8px;
                        height: 36px;
                        border-radius: 8px;
                        background: f.family == root.t.family ? Theme.surface-3 : ra.has-hover ? Theme.surface-2 : transparent;
                        Text { x: 10px; width: parent.width - 20px; text: f.label; font-family: f.family; font-size: 16px; color: Theme.text; vertical-alignment: center; overflow: elide; }
                        ra := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.set-str("family", f.family);
                                root.fonts-open = false;
                            }
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            ToolChip { icon: EIcons.align-left; on: root.t.align == "left"; clicked => { root.set-str("align", "left"); } }
            ToolChip { icon: EIcons.align-center; on: root.t.align == "center"; clicked => { root.set-str("align", "center"); } }
            ToolChip { icon: EIcons.align-right; on: root.t.align == "right"; clicked => { root.set-str("align", "right"); } }
            Rectangle { width: 4px; }
            ToolChip { icon: EIcons.bold; on: root.t.bold; enabled: root.t.wmin != root.t.wmax; clicked => { root.set-toggle("bold", !root.t.bold); } }
            ToolChip { icon: EIcons.italic; on: root.t.italic; enabled: root.t.italic-ok; clicked => { root.set-toggle("italic", !root.t.italic); } }
            Rectangle { horizontal-stretch: 1; }
        }
        VerticalLayout {
            spacing: 6px;
            Heading { text: I18n.t("photo.text.ctl.color", I18n.rev).to-uppercase(); }
            Swatches { value: root.t.color; picked(c) => { root.set-color("color", c); } }
        }
        EdSliderRow {
            label: I18n.t("photo.text.ctl.size", I18n.rev);
            value-text: root.t.size;
            value: root.t.size;
            minimum: 8;
            maximum: root.t.size-max;
            origin: 8;
            changed(v) => { root.set-num("size", v); }
        }
        if root.t.wmin != root.t.wmax: EdSliderRow {
            label: I18n.t("photo.text.ctl.weight", I18n.rev);
            value-text: root.t.weight;
            value: root.t.weight;
            minimum: root.t.wmin;
            maximum: root.t.wmax;
            origin: root.t.wmin;
            step: 100;
            changed(v) => { root.set-num("weight", v); }
        }
        EdSliderRow {
            label: I18n.t("photo.text.ctl.spacing", I18n.rev);
            value-text: root.t.spacing;
            value: root.t.spacing;
            minimum: -10;
            maximum: 60;
            changed(v) => { root.set-num("spacing", v); }
            reset => { root.set-num("spacing", 0); }
        }
        EdSliderRow {
            label: I18n.t("photo.text.ctl.line", I18n.rev);
            value-text: Math.round(root.t.line * 100) / 100;
            value: root.t.line;
            minimum: 0.7;
            maximum: 2.5;
            step: 0.05;
            origin: 1.15;
            changed(v) => { root.set-num("line", v); }
            reset => { root.set-num("line", 1.15); }
        }
        EdSliderRow {
            label: I18n.t("photo.text.ctl.rotation", I18n.rev);
            value-text: root.t.rotation + "°";
            value: root.t.rotation;
            minimum: -180;
            maximum: 180;
            changed(v) => { root.set-num("rotation", v); }
            reset => { root.set-num("rotation", 0); }
        }
        EdSliderRow {
            label: I18n.t("photo.text.ctl.opacity", I18n.rev);
            value-text: root.t.opacity + "%";
            value: root.t.opacity;
            minimum: 0;
            maximum: 100;
            origin: 100;
            changed(v) => { root.set-num("opacity", v); }
            reset => { root.set-num("opacity", 100); }
        }
        Rectangle {
            height: sl.preferred-height;
            border-radius: 16px;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.bg-elev;
            sl := VerticalLayout {
                padding: 12px;
                spacing: 12px;
                ToggleHeader { title: I18n.t("photo.text.ctl.stroke", I18n.rev); on: root.t.stroke; toggled(v) => { root.set-toggle("stroke", v); } }
                if root.t.stroke: Swatches { value: root.t.stroke-color; picked(c) => { root.set-color("stroke.color", c); } }
                if root.t.stroke: EdSliderRow {
                    label: I18n.t("photo.text.ctl.width", I18n.rev);
                    value-text: root.t.stroke-width;
                    value: root.t.stroke-width;
                    minimum: 1;
                    maximum: root.t.stroke-max;
                    origin: 1;
                    changed(v) => { root.set-num("stroke.width", v); }
                }
            }
        }
        Rectangle {
            height: shl.preferred-height;
            border-radius: 16px;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.bg-elev;
            shl := VerticalLayout {
                padding: 12px;
                spacing: 12px;
                ToggleHeader { title: I18n.t("photo.text.ctl.shadow", I18n.rev); on: root.t.shadow; toggled(v) => { root.set-toggle("shadow", v); } }
                if root.t.shadow: Swatches { value: root.t.shadow-color; picked(c) => { root.set-color("shadow.color", c); } }
                if root.t.shadow: EdSliderRow {
                    label: I18n.t("photo.text.ctl.blur", I18n.rev);
                    value-text: root.t.shadow-blur;
                    value: root.t.shadow-blur;
                    minimum: 0;
                    maximum: 80;
                    changed(v) => { root.set-num("shadow.blur", v); }
                }
                if root.t.shadow: EdSliderRow {
                    label: "X";
                    value-text: root.t.shadow-x;
                    value: root.t.shadow-x;
                    minimum: -40;
                    maximum: 40;
                    changed(v) => { root.set-num("shadow.x", v); }
                    reset => { root.set-num("shadow.x", 0); }
                }
                if root.t.shadow: EdSliderRow {
                    label: "Y";
                    value-text: root.t.shadow-y;
                    value: root.t.shadow-y;
                    minimum: -40;
                    maximum: 40;
                    changed(v) => { root.set-num("shadow.y", v); }
                    reset => { root.set-num("shadow.y", 0); }
                }
            }
        }
        Rectangle {
            height: bgl.preferred-height;
            border-radius: 16px;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.bg-elev;
            bgl := VerticalLayout {
                padding: 12px;
                spacing: 12px;
                ToggleHeader { title: I18n.t("photo.text.ctl.background", I18n.rev); on: root.t.bg; toggled(v) => { root.set-toggle("bg", v); } }
                if root.t.bg: Swatches { value: root.t.bg-color; picked(c) => { root.set-color("bg.color", c); } }
                if root.t.bg: EdSliderRow {
                    label: I18n.t("photo.text.ctl.padding", I18n.rev);
                    value-text: root.t.bg-padding;
                    value: root.t.bg-padding;
                    minimum: 0;
                    maximum: root.t.bg-max;
                    changed(v) => { root.set-num("bg.padding", v); }
                }
                if root.t.bg: EdSliderRow {
                    label: I18n.t("photo.text.ctl.radius", I18n.rev);
                    value-text: root.t.bg-radius;
                    value: root.t.bg-radius;
                    minimum: 0;
                    maximum: root.t.bg-max;
                    changed(v) => { root.set-num("bg.radius", v); }
                }
            }
        }
    }
}

