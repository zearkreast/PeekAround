// Photos timeline / Favorites / search results (GalleryPage.tsx, timeline mode)

import { Theme, Motion, I18n } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Shell, GridState, Page } from "../globals.slint";
import { MediaGrid } from "grid.slint";
import { Button, ButtonVariant, ButtonSize } from "../components/button.slint";
import { Skeleton, EmptyState, Spinner } from "../components/feedback.slint";
import { ExploreState } from "explore/state.slint";
import { EIcons } from "explore/icons.slint";
import { Carousel, SectionLink, StripCard } from "explore/cards.slint";

export component PhotosPage inherits Rectangle {
    in property <image> title-icon: Icons.images;
    in property <color> title-icon-color: Theme.accent;
    callback slideshow();
    // memories row under the title: the timeline only, never Favorites / search
    property <length> strip-h: Shell.page == Page.photos && ExploreState.show-strip && ExploreState.strip.length > 0 ? 268px : 0px;
    property <length> head-h: 128px + root.strip-h;

    grid := MediaGrid {
        width: root.width;
        height: root.height;
        tiles: GridState.tiles;
        headers: GridState.headers;
        grid-height: GridState.grid-height;
        header-height: root.head-h;
        title-height: 128px;
        scroll-y <=> GridState.scroll-y;
        viewport-changed(y, h, w) => {
            GridState.viewport-changed(y, h, w);
            Shell.title-revealed = y + self.header-height > 96px;
        }
        open(i) => { GridState.open(i); }

        title-icon: root.title-icon;
        title-icon-color: root.title-icon-color;
        title: GridState.title;
        subtitle: GridState.loading ? I18n.t("common.loading", I18n.rev) : GridState.subtitle;
        action-label: GridState.total > 0 ? I18n.t("nav.slideshow", I18n.rev) : "";
        action-icon: Icons.play;
        action => { root.slideshow(); }

        if root.strip-h > 0: VerticalLayout {
            y: 116px;
            height: root.strip-h - 16px;
            spacing: 12px;
            HorizontalLayout {
                height: 36px;
                spacing: 8px;
                VerticalLayout { alignment: center; Image { source: EIcons.sparkles; colorize: Theme.accent; width: 16px; height: 16px; } }
                Text {
                    text: I18n.t("explore.memories", I18n.rev);
                    font-family: Theme.font-display;
                    font-size: 18px;
                    font-weight: 600;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                SectionLink {
                    text: I18n.t("explore.seeAll", I18n.rev);
                    clicked => { Shell.navigate(Page.explore); }
                }
            }
            Carousel {
                row-height: 200px;
                for m in ExploreState.strip: StripCard { d: m; clicked => { ExploreState.open(m.key); } }
            }
        }
    }

    // first load: shimmer rows where the grid will be
    if GridState.loading: Rectangle {
        x: grid.grid-x;
        y: root.head-h;
        width: grid.grid-width;
        height: root.height - root.head-h;
        clip: true;
        for i in 18: Skeleton {
            property <int> ci: Math.mod(i, 6);
            property <int> ri: Math.floor(i / 6);
            x: (parent.width + 6px) / 6 * ci;
            y: 62px + ri * 226px;
            width: (parent.width + 6px) / 6 - 6px;
            height: 220px;
        }
    }

    if !GridState.loading && GridState.total == 0: VerticalLayout {
        y: root.head-h;
        height: root.height - root.head-h;
        alignment: start;
        EmptyState {
            icon: GridState.error != "" ? Icons.triangle-alert : Icons.images;
            title: GridState.error != "" ? I18n.t("common.error", I18n.rev) : Shell.page == Page.search ? I18n.t("gallery.noResults", I18n.rev) : I18n.t("gallery.empty", I18n.rev);
            body: GridState.error;
        }
        if GridState.error != "": HorizontalLayout {
            alignment: center;
            Button {
                text: I18n.t("common.retry", I18n.rev);
                icon: Icons.refresh-cw;
                has-icon: true;
                clicked => { GridState.retry(); }
            }
        }
    }
}
