// Settings (SettingsPage.tsx + GeneralSections / SystemSections / DesktopSection / Shortcuts):
// a section nav with search + scroll-spy, then every section → cards → rows. The rows are data
// (Rust: src/pages/settings.rs builds them, filters them by the search, applies changes), so the
// search works in both languages + keywords like the web UI.

import { Theme, Motion, I18n } from "../theme.slint";
import { Icons } from "../icons.slint";
import { PIcons } from "icons.slint";
import { Icon } from "../components/icon.slint";
import { PrefsState, Shell } from "../globals.slint";
import { LibIcons } from "state.slint";
import { Badge, Kbd, Spinner } from "../components/feedback.slint";
import { Segmented, SegOption, Switch, Slider, ColorSwatches, TextField } from "../components/inputs.slint";
import { Select, SelectOption } from "../components/overlays.slint";
import { Button, ButtonVariant, ButtonSize, IconButton, IconButtonSize } from "../components/button.slint";
import { ScrollBar } from "scroll.slint";

export struct SetRow {
    key: string,
    // switch | seg | select | slider | buttons | text | password | info | accent | lib | device | lan-urls | about | keys | meta-lib | empty-note
    kind: string,
    label: string,
    hint: string,
    value: string,
    checked: bool,
    num: float,
    min: float,
    max: float,
    step: float,
    unit: string,
    options: [SegOption],
    sel-options: [SelectOption],
    enabled: bool,
    // buttons: up to 3 (btn = "key|label|icon|variant" handled in Rust → these fields)
    b1-key: string,
    b1-label: string,
    b1-icon: image,
    b1-primary: bool,
    b1-busy: bool,
    b2-key: string,
    b2-label: string,
    b2-icon: image,
    b3-key: string,
    b3-label: string,
    b3-icon: image,
    // lib / device rows
    color: color,
    icon: string,
    sub: string,
    badge: string,
    online: bool,
    keys: [string],
    image: image,
    urls: [string],
    stack: bool,
    warn: string,
}

export struct SetCard {
    id: string,
    title: string,
    icon: image,
    // "device" | "server" | ""
    scope: string,
    rows: [SetRow],
}

export struct SetSection {
    id: string,
    title: string,
    icon: image,
    cards: [SetCard],
}

export struct SetNav {
    id: string,
    label: string,
    icon: image,
}

export global SetState {
    in property <[SetSection]> sections;
    in property <[SetNav]> nav;
    in-out property <string> active: "appearance";
    in-out property <string> query;
    in property <bool> empty;
    in-out property <length> scroll-y;
    // MEGA login form
    in-out property <string> mega-email;
    in-out property <string> mega-password;
    in-out property <string> mega-code;
    callback changed(/* key */ string, /* value */ string);
    callback action(/* key */ string);
    callback search(string);
    callback jump(string);
    callback scrolled(length, length);
    callback section-y(int, length);
}

component NavItem inherits Rectangle {
    in property <SetNav> item;
    in property <bool> active;
    callback clicked();
    height: 36px;
    border-radius: 12px;
    background: active ? Theme.surface-2 : ta.has-hover ? Theme.surface : transparent;
    animate background { duration: Motion.fast; }
    if root.active: Rectangle {
        x: 0;
        y: 8px;
        width: 3px;
        height: parent.height - 16px;
        border-radius: 2px;
        background: Theme.accent;
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        Icon { source: root.item.icon; tint: root.active ? Theme.accent : Theme.text-dim; size: 16px; }
        Text {
            text: root.item.label;
            font-size: 13.5px;
            font-weight: 500;
            color: root.active || ta.has-hover ? Theme.text : Theme.text-dim;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component RowButton inherits Button {
    in property <string> key;
    size: ButtonSize.sm;
    clicked => { SetState.action(self.key); }
}

// one row of a card
component RowView inherits Rectangle {
    in property <SetRow> r;
    in property <bool> first;
    in property <bool> last;
    min-height: lay.preferred-height;
    property <bool> wide-control: r.stack || r.kind == "lan-urls";
    lay := VerticalLayout {
        padding-top: root.first ? 0px : 14px;
        padding-bottom: root.last ? 0px : 14px;
        // a library of the libraries card
        if root.r.kind == "lib": HorizontalLayout {
            spacing: 12px;
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 12px;
                background: root.r.color;
                Image { source: LibIcons.get(root.r.icon); colorize: #ffffff; width: 16px; height: 16px; }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text { text: root.r.label; font-size: 14px; font-weight: 500; color: Theme.text; overflow: elide; }
                Text { text: root.r.sub; font-size: 11px; font-family: "monospace"; color: Theme.text-faint; overflow: elide; }
            }
            VerticalLayout { alignment: center; Badge { text: root.r.badge; } }
            lta := TouchArea { enabled: root.r.enabled; mouse-cursor: pointer; clicked => { SetState.action(root.r.key); } }
        }
        // a phone of the devices card
        if root.r.kind == "device": HorizontalLayout {
            spacing: 12px;
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 12px;
                background: Theme.surface-2;
                Image { source: PIcons.smartphone; colorize: Theme.text-dim; width: 18px; height: 18px; }
                Rectangle {
                    x: parent.width - 10px;
                    y: parent.height - 10px;
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    border-width: 2px;
                    border-color: Theme.bg-elev;
                    background: root.r.online ? Theme.ok : Theme.text-faint;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text { text: root.r.label; font-size: 14px; font-weight: 500; color: Theme.text; overflow: elide; }
                Text { text: root.r.sub; font-size: 12px; color: root.r.warn != "" ? Theme.warn : Theme.text-dim; overflow: elide; }
            }
            if root.r.b1-key != "": VerticalLayout { alignment: center; RowButton { key: root.r.b1-key; text: root.r.b1-label; variant: root.r.b1-primary ? ButtonVariant.primary : ButtonVariant.secondary; } }
            if root.r.b2-key != "": VerticalLayout { alignment: center; RowButton { key: root.r.b2-key; text: root.r.b2-label; variant: ButtonVariant.ghost; } }
        }
        // LAN addresses + QR
        if root.r.kind == "lan-urls": HorizontalLayout {
            spacing: 20px;
            padding-top: 4px;
            padding-bottom: 4px;
            Rectangle {
                width: 112px;
                height: 112px;
                border-radius: 12px;
                background: #ffffff;
                Image { source: root.r.image; width: 100px; height: 100px; image-rendering: pixelated; }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                Text { text: root.r.label; font-size: 12px; color: Theme.text-faint; }
                for u in root.r.urls: Text {
                    text: u;
                    font-size: 14px;
                    font-family: "monospace";
                    color: Theme.accent;
                    // copy (the desktop LAN address is typed into the phone app, not opened in a browser)
                    TouchArea { mouse-cursor: pointer; clicked => { SetState.action("copy-url:" + u); } }
                }
                Rectangle { height: 6px; }
                Text { text: root.r.hint; font-size: 12px; color: Theme.text-faint; wrap: word-wrap; }
                if root.r.warn != "": Text { text: root.r.warn; font-size: 12px; color: Theme.text-faint; wrap: word-wrap; }
            }
        }
        // about: logo + name + version line
        if root.r.kind == "about": HorizontalLayout {
            spacing: 16px;
            padding-bottom: 4px;
            Image { source: Icons.logo; width: 48px; height: 48px; }
            VerticalLayout {
                alignment: center;
                Text { text: "PeekAround"; font-family: Theme.font-display; font-size: 24px; font-weight: 700; color: Theme.text; }
                Text { text: root.r.sub; font-size: 12px; color: Theme.text-faint; }
            }
        }
        // a shortcut group
        if root.r.kind == "keys": VerticalLayout {
            Text { text: root.r.label.to-uppercase(); height: 26px; font-size: 11px; font-weight: 600; letter-spacing: 0.6px; color: Theme.text-faint; vertical-alignment: center; }
        }
        if root.r.kind == "key": HorizontalLayout {
            spacing: 8px;
            Text { text: root.r.label; font-size: 14px; color: Theme.text-dim; vertical-alignment: center; horizontal-stretch: 1; }
            for k in root.r.keys: VerticalLayout { alignment: center; Kbd { text: k; } }
        }
        // metadata diagnostics of a library
        if root.r.kind == "meta-lib": HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text { text: root.r.label; font-size: 14px; font-weight: 500; color: Theme.text; overflow: elide; }
                Text { text: root.r.sub; font-size: 12px; color: Theme.text-dim; wrap: word-wrap; }
            }
            if root.r.b1-key != "": VerticalLayout { alignment: center; RowButton { key: root.r.b1-key; text: root.r.b1-label; icon: root.r.b1-icon; has-icon: true; variant: ButtonVariant.ghost; loading: root.r.b1-busy; enabled: root.r.enabled; } }
        }
        if root.r.kind == "note": Text { text: root.r.label; font-size: 14px; color: Theme.text-dim; wrap: word-wrap; }
        // MEGA login form
        if root.r.kind == "mega-form": VerticalLayout {
            spacing: 10px;
            Text { text: root.r.hint; font-size: 12px; color: Theme.text-faint; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 8px;
                TextField { horizontal-stretch: 1; placeholder: I18n.t("mega.account.email", I18n.rev); text <=> SetState.mega-email; enabled: root.r.enabled; }
                TextField { horizontal-stretch: 1; placeholder: I18n.t("mega.account.password", I18n.rev); text <=> SetState.mega-password; enabled: root.r.enabled; accepted => { SetState.action("mega-login"); } }
            }
            if root.r.value == "mfa": TextField { placeholder: I18n.t("mega.account.code", I18n.rev); text <=> SetState.mega-code; accepted => { SetState.action("mega-login"); } }
            if root.r.warn != "": Text { text: root.r.warn; font-size: 12px; color: Theme.danger; wrap: word-wrap; }
            HorizontalLayout {
                alignment: start;
                RowButton { key: "mega-login"; text: I18n.t("mega.account.login", I18n.rev); variant: ButtonVariant.primary; loading: root.r.b1-busy; enabled: SetState.mega-email != "" && SetState.mega-password != ""; }
            }
            Text { text: I18n.t("mega.account.privacy", I18n.rev); font-size: 11px; color: Theme.text-faint; wrap: word-wrap; }
        }
        // the generic "label + hint | control" row
        if root.r.kind != "lib" && root.r.kind != "device" && root.r.kind != "lan-urls" && root.r.kind != "about" && root.r.kind != "keys" && root.r.kind != "key" && root.r.kind != "meta-lib" && root.r.kind != "note" && root.r.kind != "mega-form": VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                spacing: 24px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text { text: root.r.label; font-size: 14px; font-weight: 500; color: Theme.text; wrap: word-wrap; }
                        if root.r.badge != "": Badge { text: root.r.badge; fg: Theme.warn; }
                    }
                    if root.r.hint != "": Text { text: root.r.hint; font-size: 12px; color: Theme.text-faint; wrap: word-wrap; }
                }
                if !root.wide-control: VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        if root.r.kind == "switch": Switch {
                            checked: root.r.checked;
                            enabled: root.r.enabled;
                            toggled(v) => { SetState.changed(root.r.key, v ? "true" : "false"); }
                        }
                        if root.r.kind == "seg": Segmented {
                            small: true;
                            options: root.r.options;
                            value: root.r.value;
                            changed-value(v) => { SetState.changed(root.r.key, v); }
                        }
                        if root.r.kind == "select": Select {
                            width: 180px;
                            small: true;
                            options: root.r.sel-options;
                            value: root.r.value;
                            changed-value(v) => { SetState.changed(root.r.key, v); }
                        }
                        if root.r.kind == "accent": ColorSwatches {
                            colors: PrefsState.accents;
                            value: PrefsState.accent;
                            picked(c) => { PrefsState.set-accent(c); }
                        }
                        if root.r.kind == "slider": Slider {
                            width: 200px;
                            minimum: root.r.min;
                            maximum: root.r.max;
                            step: root.r.step;
                            value: root.r.num;
                            value-text: Math.round(self.value) + root.r.unit;
                            committed(v) => { SetState.changed(root.r.key, Math.round(v)); }
                            changed-value(v) => { SetState.changed(root.r.key, Math.round(v)); }
                        }
                        if root.r.kind == "text" || root.r.kind == "number": TextField {
                            width: root.r.kind == "number" ? 96px : 140px;
                            text: root.r.value;
                            enabled: root.r.enabled;
                            accepted(v) => { SetState.changed(root.r.key, v); }
                            changed focused => { if !self.focused { SetState.changed(root.r.key, self.text); } }
                        }
                        if root.r.kind == "lan": TextField {
                            width: 96px;
                            text: root.r.value;
                            enabled: !root.r.checked;
                            accepted(v) => { SetState.changed("lanPort", v); }
                            changed focused => { if !self.focused { SetState.changed("lanPort", self.text); } }
                        }
                        if root.r.kind == "lan": Switch {
                            checked: root.r.checked;
                            enabled: root.r.enabled;
                            toggled(v) => { SetState.changed(root.r.key, v ? "true" : "false"); }
                        }
                        if root.r.kind == "status": Badge { text: root.r.value; fg: root.r.online ? Theme.ok : Theme.danger; }
                        if root.r.kind == "status" && root.r.sub != "": Badge { text: root.r.sub; }
                        if root.r.b3-key != "": RowButton { key: root.r.b3-key; text: root.r.b3-label; icon: root.r.b3-icon; has-icon: true; variant: ButtonVariant.primary; }
                        if root.r.b2-key != "" && !root.r.stack: RowButton { key: root.r.b2-key; text: root.r.b2-label; icon: root.r.b2-icon; has-icon: true; }
                        if root.r.b1-key != "" && !root.r.stack: RowButton {
                            key: root.r.b1-key;
                            text: root.r.b1-label;
                            icon: root.r.b1-icon;
                            has-icon: true;
                            variant: root.r.b1-primary ? ButtonVariant.primary : ButtonVariant.secondary;
                            loading: root.r.b1-busy;
                            enabled: root.r.enabled;
                        }
                    }
                }
            }
            // stacked controls (wide: close action, backup buttons)
            if root.r.stack: HorizontalLayout {
                spacing: 8px;
                alignment: start;
                if root.r.kind == "seg": Segmented {
                    small: true;
                    options: root.r.options;
                    value: root.r.value;
                    changed-value(v) => { SetState.changed(root.r.key, v); }
                }
                if root.r.b1-key != "": RowButton { key: root.r.b1-key; text: root.r.b1-label; icon: root.r.b1-icon; has-icon: true; }
                if root.r.b2-key != "": RowButton { key: root.r.b2-key; text: root.r.b2-label; icon: root.r.b2-icon; has-icon: true; }
                if root.r.b3-key != "": RowButton { key: root.r.b3-key; text: root.r.b3-label; icon: root.r.b3-icon; has-icon: true; variant: ButtonVariant.ghost; }
            }
        }
    }
    if !root.last: Rectangle {
        y: root.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}

component CardView inherits Rectangle {
    in property <SetCard> c;
    border-radius: 24px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.bg-elev;
    height: lay.preferred-height;
    lay := VerticalLayout {
        padding: 24px;
        spacing: 16px;
        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 12px;
                background: Theme.surface-2;
                Image { source: root.c.icon; colorize: Theme.accent; width: 16px; height: 16px; }
            }
            Text {
                text: root.c.title;
                font-family: Theme.font-display;
                font-size: 17px;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if root.c.scope != "": VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 22px;
                    width: scope-row.preferred-width + 16px;
                    border-radius: 11px;
                    border-width: 1px;
                    border-color: Theme.border;
                    scope-row := HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 4px;
                        alignment: center;
                        Icon { source: root.c.scope == "device" ? Icons.monitor : Icons.server; tint: Theme.text-faint; size: 12px; }
                        Text {
                            text: root.c.scope == "device" ? I18n.t("pref.deviceOnly", I18n.rev) : I18n.t("pref.serverWide", I18n.rev);
                            font-size: 11px;
                            font-weight: 500;
                            color: Theme.text-faint;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
        VerticalLayout {
            for row[i] in root.c.rows: RowView {
                r: row;
                first: i == 0;
                last: i == root.c.rows.length - 1;
            }
        }
    }
}

export component SettingsPage inherits Rectangle {
    property <bool> wide: root.width >= 860px;
    property <length> cw: Math.min(root.width - 56px - 12px, 1100px);
    property <length> cx: (root.width - 12px - cw) / 2;

    fl := Flickable {
        width: root.width;
        height: root.height;
        content-height: page.preferred-height + 32px + 96px;
        content-y <=> SetState.scroll-y;
        changed content-y => { SetState.scrolled(-self.content-y, self.height); Shell.title-revealed = -self.content-y > 60px; }
        page := VerticalLayout {
            x: root.cx;
            y: 32px;
            width: root.cw;
            spacing: 28px;
            alignment: start;
            Text {
                text: I18n.t("settings.title", I18n.rev);
                font-family: Theme.font-display;
                font-size: 30px;
                font-weight: 700;
                letter-spacing: -0.4px;
                color: Theme.text;
            }
            HorizontalLayout {
                spacing: 40px;
                // section nav (sticky: moved down by the scroll offset)
                if root.wide: Rectangle {
                    width: 230px;
                    nav := VerticalLayout {
                        y: Math.max(0px, -fl.content-y - 60px);
                        width: parent.width;
                        alignment: start;
                        spacing: 2px;
                        TextField {
                            placeholder: I18n.t("pref.search", I18n.rev);
                            icon: Icons.search;
                            has-icon: true;
                            text <=> SetState.query;
                            edited(q) => { SetState.search(q); }
                        }
                        Rectangle { height: 10px; }
                        for s in SetState.nav: NavItem {
                            item: s;
                            active: s.id == SetState.active;
                            clicked => { SetState.jump(s.id); }
                        }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: start;
                    spacing: 40px;
                    if !root.wide: TextField {
                        placeholder: I18n.t("pref.search", I18n.rev);
                        icon: Icons.search;
                        has-icon: true;
                        text <=> SetState.query;
                        edited(q) => { SetState.search(q); }
                    }
                    for sec[si] in SetState.sections: VerticalLayout {
                        spacing: 16px;
                        init => { SetState.section-y(si, self.y); }
                        changed y => { SetState.section-y(si, self.y); }
                        HorizontalLayout {
                            spacing: 10px;
                            padding-left: 4px;
                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: 12px;
                                background: Theme.accent-faint;
                                Image { source: sec.icon; colorize: Theme.accent; width: 16px; height: 16px; }
                            }
                            Text {
                                text: sec.title;
                                font-family: Theme.font-display;
                                font-size: 20px;
                                font-weight: 700;
                                color: Theme.text;
                                vertical-alignment: center;
                            }
                        }
                        for c in sec.cards: CardView { c: c; }
                    }
                    if SetState.empty: VerticalLayout {
                        padding-top: 80px;
                        padding-bottom: 80px;
                        spacing: 12px;
                        alignment: center;
                        HorizontalLayout { alignment: center; Image { source: PIcons.search-x; colorize: Theme.text-faint; width: 40px; height: 40px; } }
                        Text { text: I18n.t1("pref.searchEmpty", "q", SetState.query, I18n.rev); font-size: 14px; color: Theme.text-dim; horizontal-alignment: center; }
                    }
                }
            }
        }
    }
    ScrollBar {
        x: root.width - self.width;
        height: root.height;
        content-height: fl.content-height;
        visible-height: fl.height;
        offset: -fl.content-y;
        scroll-to(o) => { fl.content-y = -o; }
    }
}
