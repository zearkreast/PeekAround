# Maintainer: PeekAround
# Arch Linux package built from the release AppImage.
# Build & install:   makepkg -si
# (Or simply install the ready-made PeekAround-<version>-x64.pacman from the release:  sudo pacman -U PeekAround-*.pacman)
pkgname=peekaround-bin
pkgver=1.2.0
pkgrel=1
pkgdesc="Modern, animated gallery for your folders — browse, watch, edit, slideshows & collages"
arch=('x86_64')
url="https://github.com/YOUR_GITHUB_USER/peekaround"
license=('MIT')
depends=('gtk3' 'nss' 'alsa-lib' 'libxss' 'libxtst' 'fuse2')
provides=('peekaround')
conflicts=('peekaround')
options=('!strip')
source=("PeekAround-${pkgver}-x86_64.AppImage::${url}/releases/download/v${pkgver}/PeekAround-${pkgver}-x86_64.AppImage")
sha256sums=('SKIP')

prepare() {
  chmod +x "PeekAround-${pkgver}-x86_64.AppImage"
  "./PeekAround-${pkgver}-x86_64.AppImage" --appimage-extract >/dev/null
}

package() {
  install -dm755 "${pkgdir}/opt/${pkgname}"
  cp -a squashfs-root/. "${pkgdir}/opt/${pkgname}/"
  chmod -R a+rX "${pkgdir}/opt/${pkgname}"
  install -dm755 "${pkgdir}/usr/bin"
  ln -s "/opt/${pkgname}/peekaround" "${pkgdir}/usr/bin/peekaround"
  for s in 16 32 48 64 128 256 512; do
    if [ -f "squashfs-root/usr/share/icons/hicolor/${s}x${s}/apps/peekaround.png" ]; then
      install -Dm644 "squashfs-root/usr/share/icons/hicolor/${s}x${s}/apps/peekaround.png" "${pkgdir}/usr/share/icons/hicolor/${s}x${s}/apps/peekaround.png"
    fi
  done
  install -Dm644 /dev/stdin "${pkgdir}/usr/share/applications/peekaround.desktop" <<DESKTOP
[Desktop Entry]
Name=PeekAround
Comment=Modern, animated gallery for your folders
Exec=peekaround %U
Icon=peekaround
Terminal=false
Type=Application
Categories=Graphics;Photography;Viewer;
Keywords=photo;video;gallery;slideshow;collage;
StartupWMClass=PeekAround
DESKTOP
}
